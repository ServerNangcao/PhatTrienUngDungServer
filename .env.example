# ─── Cơ sở dữ liệu ───
POSTGRES_HOST=ticketing-db
POSTGRES_PORT=5432
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing_app
POSTGRES_PASSWORD=ChangeMeInProduction!

# Connection string cho app (dùng trong appsettings hoặc env override)
ConnectionStrings__DefaultConnection=Host=ticketing-db;Port=5432;Database=ticketing;Username=ticketing_app;Password=ChangeMeInProduction!

# ─── Redis ───
REDIS_HOST=ticketing-redis
REDIS_PORT=6379
ConnectionStrings__Redis=ticketing-redis:6379

# ─── JWT ───
Jwt__Secret=SuperSecretKeyAtLeast32Characters!!
Jwt__Issuer=ticketing-api
Jwt__Audience=ticketing-client
Jwt__ExpirationInMinutes=60

# ─── Email (MailKit) ───
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SenderEmail=noreply@example.com
Email__SenderName=Ticketing Platform
Email__Password=your-app-password

# ─── Object Storage (S3-compatible: MinIO dev / R2 prod) ───
S3__ServiceUrl=http://ticketing-minio:9000
S3__AccessKey=minioadmin
S3__SecretKey=minioadmin
S3__BucketName=ticketing
S3__ForcePathStyle=true

# ─── Hangfire ───
Hangfire__DashboardEnabled=true

# ─── Application ───
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
